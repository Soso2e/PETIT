{
  "name": "petit-desktop",
  "version": "0.21.0",
  "private": true,
  "description": "PETIT desktop companion",
  "author": "Soso2e",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepare:wake-model": "node scripts/prepare-wake-model.cjs",
    "build": "npm run prepare:wake-model && electron-builder --publish never",
    "pack": "npm run prepare:wake-model && electron-builder --dir --publish never",
    "test:smoke": "node test/smoke.cjs",
    "test:package-resources": "node test/package-resources.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "jp.soso2e.petit",
    "productName": "PETIT",
    "files": [
      "*.cjs",
      "setup.html",
      "setup.js",
      "setup.css"
    ],
    "extraResources": [
      {
        "from": "../frontend/icon-512.png",
        "to": "icon.png"
      },
      {
        "from": "../scripts/wakeword/runtime.py",
        "to": "wakeword/runtime.py"
      },
      {
        "from": "../scripts/wakeword/requirements.txt",
        "to": "wakeword/requirements.txt"
      },
      {
        "from": "wakeword-assets",
        "to": "wakeword",
        "filter": [
          "wake-model.json",
          "hey_petit.onnx"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "呼びかけの検出と、PETITへの音声入力にマイクを使用します。"
      },
      "entitlements": "entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "artifactName": "PETIT-${version}-${os}-${arch}.${ext}",
    "icon": "../frontend/icon-512.png"
  }
}
