# PETIT environment variables — copy to .env and fill in your values.
# Load with: source .env  (or use a tool like python-dotenv / direnv)

# ---- LM Studio ---------------------------------------------------------------
PETIT_LM_BASE_URL=http://localhost:1234/v1
PETIT_LM_MODEL=local-model

# ---- Notion ------------------------------------------------------------------
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TASKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROP_TITLE=name
NOTION_PROP_STATUS=Status
NOTION_PROP_DUE=Date
NOTION_PROP_PRIORITY=Priority
NOTION_PROP_CATEGORY=Category
NOTION_PROP_REASON=reason
NOTION_PROP_DONE=Done
NOTION_DEFAULT_STATUS=Yet
NOTION_DONE_STATUS=Done

# ---- RAG / Embeddings --------------------------------------------------------
PETIT_EMBED_MODEL=nomic-embed-text

# ---- Obsidian vault ----------------------------------------------------------
# Windows: separate multiple vaults with ';'
PETIT_OBSIDIAN_VAULT_DIRS=C:\path\to\YourObsidianVault
# PETIT writes Daily/Memory under <first vault>\PETIT by default.
PETIT_VAULT_SUBDIR=PETIT
# Optional explicit overrides:
# PETIT_AI_DAILY_DIR=C:\path\to\YourObsidianVault\PETIT\Daily
# PETIT_AI_MEMORY_DIR=C:\path\to\YourObsidianVault\PETIT\Memory
# ---- Server ------------------------------------------------------------------
PETIT_HOST=127.0.0.1
PETIT_PORT=8000

# ---- TimeTree ----------------------------------------------------------------
TIMETREE_EMAIL=your@email.com
TIMETREE_PASSWORD=your_password
TIMETREE_CALENDAR_CODE=your_calendar_code
