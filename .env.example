# PETIT environment variables — copy to .env and fill in your values.
# Load with: source .env  (or use a tool like python-dotenv / direnv)

# ---- LM Studio ---------------------------------------------------------------
# Base URL of your LM Studio local server (OpenAI-compatible)
PETIT_LM_BASE_URL=http://localhost:1234/v1
# Model ID shown in LM Studio (e.g. "lmstudio-community/Meta-Llama-3-8B-Instruct-GGUF")
PETIT_LM_MODEL=local-model

# ---- Notion ------------------------------------------------------------------
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Share your tasks database with that integration
# 3. Copy the "Internal Integration Token" below
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ID: 32-char hex from your Notion DB URL
# e.g. https://www.notion.so/MyWorkspace/<DATABASE_ID>?v=...
NOTION_TASKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Property names in your Notion database (change if yours differ)
NOTION_PROP_TITLE=名前
NOTION_PROP_STATUS=ステータス
NOTION_PROP_DUE=期日
NOTION_PROP_PRIORITY=優先度

# ---- Server ------------------------------------------------------------------
PETIT_HOST=127.0.0.1
PETIT_PORT=8000
