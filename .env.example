# PETIT environment variables — copy to .env and fill in your values.
# Load with: source .env  (or use a tool like python-dotenv / direnv)

# ---- LM Studio ---------------------------------------------------------------
PETIT_LM_BASE_URL=http://localhost:1234/v1
PETIT_LM_MODEL=local-model
# 未設定時は各項目とも従来の PETIT_LM_* にフォールバックします。
# 同じURL・モデルなら1モデル、Agentだけ別PC/GPUなら2モデル構成です。
PETIT_CHAT_BASE_URL=http://localhost:1234/v1
PETIT_CHAT_MODEL=local-model
PETIT_CHAT_API_KEY=lm-studio
PETIT_AGENT_BASE_URL=http://192.168.x.x:1234/v1
PETIT_AGENT_MODEL=larger-agent-model
PETIT_AGENT_API_KEY=lm-studio
PETIT_ENABLE_THINKING=0
PETIT_LIGHT_MAX_TOKENS=512
# 1ターンで許可するツール実行ラウンド数。最終回答用のLLM呼び出しは別に許可します。
PETIT_MAX_TOOL_ITERATIONS=3
# auto: role=toolを優先し、LM Studioのテンプレート非対応時だけuser follow-upへ退避。
# tool: 標準tool callingのみ。user: 常に互換user follow-upを使用。
PETIT_TOOL_RESULT_MODE=auto

# ---- AivisSpeech text-to-speech ---------------------------------------------
# AivisSpeech Engineを起動してからPETITを使います。既定ポートは10101です。
PETIT_TTS_PROVIDER=aivis
PETIT_TTS_BASE_URL=http://127.0.0.1:10101
# 空欄なら /speakers の最初のスタイルを自動選択します。
PETIT_TTS_STYLE_ID=
PETIT_TTS_TIMEOUT=30
PETIT_TTS_MAX_CHARS=1000
PETIT_TTS_SPEED_SCALE=1.0
PETIT_TTS_INTONATION_SCALE=1.0
PETIT_TTS_VOLUME_SCALE=1.0

# ---- Sona Agent Core --------------------------------------------------------
PETIT_USE_SONA_CORE=0
PETIT_OWNER_ID=soso
PETIT_PERSONAL_SCOPE_ID=soso
# PETIT_SONA_CORE_AUDIT_PATH=C:\path\to\PETIT\storage\audit\sona_agent_core.jsonl

# ---- Notion ------------------------------------------------------------------
NOTION_API_KEY=
NOTION_PROJECTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_PROJECT_PROP_TITLE=プロジェクト名
NOTION_PROJECT_PROP_STATUS=ステータス
NOTION_PROJECT_PROP_OWNER=オーナー
NOTION_PROJECT_PROP_PRIORITY=優先度
NOTION_PROJECT_PROP_AREA=エリア
NOTION_PROJECT_PROP_PERIOD=期間
NOTION_PROJECT_PROP_SUMMARY=要約
NOTION_PROJECT_PROP_TASKS=タスク
NOTION_PROJECT_PROP_BLOCKED_BY=次のプロジェクトを保留中：
NOTION_PROP_TITLE=name
NOTION_PROP_STATUS=Status
NOTION_PROP_DUE=Date
NOTION_PROP_PRIORITY=Priority
NOTION_PROP_CATEGORY=Category
NOTION_PROP_AREA=エリア
NOTION_PROP_REASON=reason
NOTION_PROP_DONE_DATE=DoneDate
NOTION_TASK_PROP_PROJECT=プロジェクト
NOTION_TASK_PROP_ASSIGNEE=担当者
NOTION_TASK_PROP_PARENT=親タスク
NOTION_TASK_PROP_SUBTASKS=サブタスク
NOTION_TASK_PROP_SUMMARY=要約
NOTION_DEFAULT_STATUS=Yet
NOTION_DONE_STATUS=Done
NOTION_STATUS_YET=Yet
NOTION_STATUS_NOW=Now
NOTION_STATUS_READY=ready
NOTION_STATUS_DONE=Done
NOTION_STATUS_CANCELLED=Chancel
NOTION_PRIORITY_LOW=Low
NOTION_PRIORITY_MID=Mid
NOTION_PRIORITY_HIGH=High
NOTION_CATEGORY_JOB_HUNT=JobHunt
NOTION_CATEGORY_SCHOOL=Sch
NOTION_CATEGORY_LIFE=Life
NOTION_CATEGORY_WORK=Work
NOTION_CATEGORY_HOBBY=Hobby
NOTION_CATEGORY_EVENT=Event
NOTION_CATEGORY_CREATE=Create
NOTION_CATEGORY_LIT=LiT
NOTION_SYNC_TTL_SECONDS=300

# ---- Linkraft owner-only read sync ------------------------------------------
# Linkraft側では同じトークンのSHA-256を PETIT_READ_TOKEN_SHA256 に設定し、
# PETIT_OWNER_USER_ID にそそのLinkraft user IDを設定します。
LINKRAFT_BASE_URL=
LINKRAFT_PETIT_READ_TOKEN=
LINKRAFT_SYNC_TTL_SECONDS=300

# ---- GitHub read-only project evidence --------------------------------------
# private repositoryを読む場合は最小権限のFine-grained PAT等を設定します。
# 平文tokenはSQLite・source link・event・errorへ保存しません。
PETIT_GITHUB_TOKEN=
PETIT_GITHUB_API_URL=https://api.github.com
PETIT_GITHUB_API_VERSION=2022-11-28
PETIT_GITHUB_SYNC_TTL_SECONDS=300
PETIT_GITHUB_INITIAL_LOOKBACK_DAYS=30
PETIT_GITHUB_MAX_PAGES=3
PETIT_GITHUB_MAX_CHECK_COMMITS=50
PETIT_GITHUB_MAX_DEPLOYMENTS=20

# ---- GitHub all-repository morning review -----------------------------------
# PETIT起動中、Asia/Tokyoの8時以降に1日1回、前回cursor以降を読み取ります。
# archived・disabled・空repositoryは除外し、既定ではforkも除外します。
PETIT_GITHUB_DAILY_REVIEW_ENABLED=1
PETIT_GITHUB_DAILY_REVIEW_HOUR=8
PETIT_GITHUB_DAILY_REVIEW_TIMEZONE=Asia/Tokyo
PETIT_GITHUB_DAILY_REVIEW_POLL_MINUTES=15
PETIT_GITHUB_DAILY_REVIEW_LOOKBACK_HOURS=24
PETIT_GITHUB_DAILY_REVIEW_MAX_REPOSITORIES=50
PETIT_GITHUB_DAILY_REVIEW_MAX_COMMITS_PER_REPO=10
PETIT_GITHUB_DAILY_REVIEW_PROGRESS_MAX_CHARS=1800
PETIT_GITHUB_DAILY_REVIEW_INCLUDE_FORKS=0

# ---- RAG / Embeddings --------------------------------------------------------
PETIT_EMBED_MODEL=nomic-embed-text
PETIT_EMBED_RETRY_SECONDS=60

# ---- Obsidian vault ----------------------------------------------------------
PETIT_OBSIDIAN_VAULT_DIRS=C:\path\to\YourObsidianVault
PETIT_VAULT_SUBDIR=PETIT
# PETIT_AI_DAILY_DIR=C:\path\to\YourObsidianVault\PETIT\Daily
# PETIT_AI_MEMORY_DIR=C:\path\to\YourObsidianVault\PETIT\Memory

# ---- Calendar read-only sync ------------------------------------------------
# PETIT_CALENDAR_ICS_URLS=
# PETIT_CALENDAR_ICS_FILES=C:\path\to\calendar.ics
PETIT_CALENDAR_SYNC_TTL_SECONDS=300

# ---- Server ------------------------------------------------------------------
PETIT_HOST=127.0.0.1
PETIT_PORT=8000

# ---- TimeTree ----------------------------------------------------------------
TIMETREE_EMAIL=
TIMETREE_PASSWORD=
TIMETREE_CALENDAR_CODE=
