# PETIT environment variables — copy to .env and fill in your values.
# Load with: source .env  (or use a tool like python-dotenv / direnv)

# ---- LM Studio ---------------------------------------------------------------
PETIT_LM_BASE_URL=http://localhost:1234/v1
PETIT_LM_MODEL=local-model
# 会話用（短い返答・雑談・自然文整形）とエージェント用（ツール・長文・複雑判断）
# 同じモデル名にすれば従来どおり1モデル構成で動作します。
PETIT_CHAT_MODEL=local-model
PETIT_AGENT_MODEL=local-model
PETIT_ENABLE_THINKING=0
PETIT_LIGHT_MAX_TOKENS=512
PETIT_AGENT_MESSAGE_CHARS=280
PETIT_AGENT_HISTORY_CHARS=1800
# 読み取り系の重い相談は軽量モデルで先に返し、エージェント本回答をJobで後から追加表示する。
PETIT_DEFER_AGENT_JOBS=1

# ---- Notion ------------------------------------------------------------------
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_TASKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROP_TITLE=name
NOTION_PROP_STATUS=Status
NOTION_PROP_DUE=Date
NOTION_PROP_PRIORITY=Priority
NOTION_PROP_CATEGORY=Category
NOTION_PROP_REASON=reason
PETIT_EMBED_RETRY_SECONDS=60
NOTION_PROP_DONE_DATE=DoneDate
NOTION_DEFAULT_STATUS=Yet
NOTION_DONE_STATUS=Done
NOTION_STATUS_YET=Yet
NOTION_STATUS_NOW=Now
NOTION_STATUS_READY=ready
NOTION_STATUS_DONE=Done
NOTION_STATUS_CANCELLED=Chancel
NOTION_PRIORITY_LOW=Low
NOTION_PRIORITY_MID=Mid
NOTION_PRIORITY_HIGH=High
NOTION_CATEGORY_JOB_HUNT=JobHunt
NOTION_CATEGORY_SCHOOL=Sch
NOTION_CATEGORY_LIFE=Life
NOTION_CATEGORY_WORK=Work
NOTION_CATEGORY_HOBBY=Hobby
NOTION_SYNC_TTL_SECONDS=300
NOTION_CATEGORY_EVENT=Event
NOTION_CATEGORY_CREATE=Create
NOTION_CATEGORY_LIT=LiT

# ---- RAG / Embeddings --------------------------------------------------------
PETIT_EMBED_MODEL=nomic-embed-text

# ---- Obsidian vault ----------------------------------------------------------
# Windows: separate multiple vaults with ';'
PETIT_OBSIDIAN_VAULT_DIRS=C:\path\to\YourObsidianVault
# PETIT writes Daily/Memory under <first vault>\PETIT by default.
PETIT_VAULT_SUBDIR=PETIT
# Optional explicit overrides:
# PETIT_AI_DAILY_DIR=C:\path\to\YourObsidianVault\PETIT\Daily
# PETIT_AI_MEMORY_DIR=C:\path\to\YourObsidianVault\PETIT\Memory

# ---- Calendar read-only sync ------------------------------------------------
# Google Calendar private iCal/ICS URLs or local exported .ics files.
# Windows: separate multiple entries with ';'
# PETIT_CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/.../basic.ics
# PETIT_CALENDAR_ICS_FILES=C:\path\to\calendar.ics
PETIT_CALENDAR_SYNC_TTL_SECONDS=300

# ---- Server ------------------------------------------------------------------
PETIT_HOST=127.0.0.1
PETIT_PORT=8000

# ---- TimeTree ----------------------------------------------------------------
TIMETREE_EMAIL=your@email.com
TIMETREE_PASSWORD=your_password
TIMETREE_CALENDAR_CODE=your_calendar_code
